<!-- templates/index.html -->
<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- 30秒自动刷新 -->
    <meta http-equiv="refresh" content="30">
    <title>goForward</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            margin: auto;
            max-width: 1100px;
            background-color: #f8f9fa;
            font-size: 16px;
            padding: 20px;
        }

        h2 {
            color: #343a40;
        }

        .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 10px;
        }

        .table-container {
            overflow-x: auto;
            margin-top: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            border: 1px solid #dee2e6;
            padding: 12px;
            text-align: left;
        }

        th {
            background-color: #2181b5;
            color: #fff;
        }

        .but-container {
            display: flex;
            gap: 6px;
        }

        .but {
            display: inline-block;
            min-width: 40px;
            height: 28px;
            color: white;
            background-color: #28a745;
            border: none;
            padding: 4px 8px;
            cursor: pointer;
            text-decoration-line: none;
            text-align: center;
            line-height: 20px;
            font-size: 14px;
        }

        .but.edit {
            background-color: #6c757d;
        }

        .but.danger {
            background-color: #d93b3b;
        }

        form {
            margin-top: 20px;
        }

        input,
        select,
        button {
            margin-bottom: 10px;
            width: 100%;
            box-sizing: border-box;
            padding: 12px;
        }

        select {
            background-color: #fff;
            border: 1px solid #ced4da;
            border-radius: 4px;
            color: #495057;
        }

        label {
            display: block;
            margin-bottom: 5px;
            color: #495057;
        }

        .send {
            border: none;
            color: white;
            background-color: #2181b5;
        }

        .row {
            display: flex;
            gap: 10px;
        }

        .row>div {
            flex: 1;
        }

        .status-running {
            color: #28a745;
            font-weight: bold;
        }

        .status-stopped {
            color: #d93b3b;
            font-weight: bold;
        }

        .status-abnormal {
            color: #d9a00d;
            font-weight: bold;
        }

        .modal {
            display: none;
            position: fixed;
            z-index: 1;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0, 0, 0, 0.4);
        }

        .modal-content {
            background-color: #fefefe;
            margin: 5% auto;
            padding: 20px;
            border: 1px solid #888;
            width: 80%;
            max-width: 600px;
        }

        .close {
            color: #aaa;
            float: right;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
        }
    </style>
</head>

<body>
    <div class="toolbar">
        <h2>转发列表</h2>
        <div>
            <a class="but" href="/export">导出</a>
            <button class="but edit" onclick="document.getElementById('importFile').click()">导入</button>
            <form id="importForm" action="/import" method="post" enctype="multipart/form-data" style="display:none;">
                <input type="hidden" name="csrfToken" value="{{.csrfToken}}">
                <input type="file" id="importFile" name="file" accept=".json" onchange="document.getElementById('importForm').submit()">
            </form>
        </div>
    </div>
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>本地端口</th>
                    <th>远程地址</th>
                    <th>远程端口</th>
                    <th>类型</th>
                    <th>状态</th>
                    <th>流量</th>
                    <th>最大连接</th>
                    <th>操作</th>
                    <th>备注</th>
                </tr>
            </thead>
            <tbody>
                {{range .forwardList}}
                <tr>
                    <td>{{.LocalPort}}</td>
                    <td>{{.RemoteAddr}}</td>
                    <td>{{.RemotePort}}</td>
                    <td>{{.Protocol}}</td>
                    <td class="
                        {{if eq .Status 0}}status-running{{else if eq .Status 2}}status-abnormal{{else}}status-stopped{{end}}">
                        {{if eq .Status 0}}运行中{{else if eq .Status 2}}异常{{else}}已停用{{end}}
                    </td>
                    <td class="data">{{if gt .TotalGigabyte 0}}{{.TotalGigabyte}}G{{end}}{{.TotalBytes}}</td>
                    <td>{{if gt .MaxConns 0}}{{.MaxConns}}{{else}}不限{{end}}</td>
                    <td>
                        <div class="but-container">
                            <form action="/do/{{.Id}}" method="post" style="margin:0;display:inline;">
                                <input type="hidden" name="csrfToken" value="{{$.csrfToken}}">
                                <button class="but" type="submit"
                                    style="background-color: #{{if eq .Status 0}}d93b3b{{else}}2181b5{{end}};"
                                    onclick="return confirm('确认{{if eq .Status 0}}停用{{else}}启用{{end}}此转发？')">
                                    {{if eq .Status 0}}停用{{else}}启用{{end}}
                                </button>
                            </form>
                            <button class="but edit" onclick="openEdit({{.Id}}, '{{.LocalPort}}', '{{.RemoteAddr}}', '{{.RemotePort}}', '{{.Protocol}}', '{{.Ps}}', {{.MaxConns}}, {{.HealthCheck}})">编辑</button>
                            <form action="/del/{{.Id}}" method="post" style="margin:0;display:inline;">
                                <input type="hidden" name="csrfToken" value="{{$.csrfToken}}">
                                <button class="but danger" type="submit" onclick="return confirm('确认删除此转发？此操作不可恢复。')">删除</button>
                            </form>
                        </div>
                    </td>
                    <td>{{.Ps}}</td>
                </tr>
                {{end}}
            </tbody>
        </table>
    </div>

    <h2>添加转发</h2>
    <form action="/add" method="post">
        <input type="hidden" name="csrfToken" value="{{.csrfToken}}">
        <div class="row">
            <div>
                <input type="text" name="localPort" placeholder="本地端口" required>
            </div>
            <div>
                <input type="text" name="remotePort" placeholder="远程端口" required>
            </div>
        </div>
        <input type="text" name="remoteAddr" placeholder="远程地址（支持 IPv4/IPv6/域名）" required>
        <input type="text" name="ps" placeholder="备注信息">
        <div class="row">
            <div>
                <label for="protocol">类型:</label>
                <select id="protocol" name="protocol" required>
                    <option value="tcp">TCP</option>
                    <option value="udp">UDP</option>
                </select>
            </div>
            <div>
                <label for="maxConns">最大连接数 (0=不限，仅TCP)</label>
                <input type="number" id="maxConns" name="maxConns" value="0" min="0">
            </div>
        </div>
        <label>
            <input type="checkbox" name="healthCheck" style="width:auto;margin-right:6px;">
            启用远端健康检查（仅TCP，每30秒探活）
        </label>
        <input class="send" type="submit" value="添加" />
    </form>

    <!-- 编辑弹窗 -->
    <div id="editModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="document.getElementById('editModal').style.display='none'">&times;</span>
            <h2>编辑转发</h2>
            <form id="editForm" action="" method="post">
                <input type="hidden" name="csrfToken" value="{{.csrfToken}}">
                <input type="text" name="localPort" id="e_localPort" placeholder="本地端口" required>
                <input type="text" name="remotePort" id="e_remotePort" placeholder="远程端口" required>
                <input type="text" name="remoteAddr" id="e_remoteAddr" placeholder="远程地址" required>
                <input type="text" name="ps" id="e_ps" placeholder="备注信息">
                <label for="e_protocol">类型:</label>
                <select id="e_protocol" name="protocol" required>
                    <option value="tcp">TCP</option>
                    <option value="udp">UDP</option>
                </select>
                <label for="e_maxConns">最大连接数 (0=不限)</label>
                <input type="number" id="e_maxConns" name="maxConns" value="0" min="0">
                <label>
                    <input type="checkbox" name="healthCheck" id="e_healthCheck" style="width:auto;margin-right:6px;">
                    启用远端健康检查
                </label>
                <input class="send" type="submit" value="保存" />
            </form>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const trafficCells = document.querySelectorAll('.data');
            trafficCells.forEach(cell => {
                let traffic = cell.textContent.trim();
                let valueInBytes = 0;
                if (traffic.includes('G')) {
                    let parts = traffic.split('G');
                    valueInBytes = parseFloat(parts[0]) * 1024 * 1024 * 1024;
                    if (parts[1]) {
                        valueInBytes += parseInt(parts[1]);
                    }
                } else {
                    valueInBytes = parseInt(traffic) || 0;
                }
                if (valueInBytes >= 1e9) {
                    cell.textContent = (valueInBytes / 1e9).toFixed(2) + ' GB';
                } else if (valueInBytes >= 1e6) {
                    cell.textContent = (valueInBytes / 1e6).toFixed(2) + ' MB';
                } else if (valueInBytes >= 1e3) {
                    cell.textContent = (valueInBytes / 1e3).toFixed(2) + ' KB';
                } else {
                    cell.textContent = valueInBytes + ' B';
                }
            });
        });

        function openEdit(id, localPort, remoteAddr, remotePort, protocol, ps, maxConns, healthCheck) {
            document.getElementById('editForm').action = '/edit/' + id;
            document.getElementById('e_localPort').value = localPort;
            document.getElementById('e_remoteAddr').value = remoteAddr;
            document.getElementById('e_remotePort').value = remotePort;
            document.getElementById('e_protocol').value = protocol;
            document.getElementById('e_ps').value = ps;
            document.getElementById('e_maxConns').value = maxConns;
            document.getElementById('e_healthCheck').checked = healthCheck === true || healthCheck === 'true';
            document.getElementById('editModal').style.display = 'block';
        }
    </script>
</body>

</html>
